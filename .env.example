# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
# All keys are optional and free. With none set, the app runs on TCGdex + bundled snapshot values.

# PSA Public API token (free with a PSA account). Live PSA 10 population for cards with psaSpecId.
# https://www.psacard.com/publicapi
PSA_API_TOKEN=

# PokemonPriceTracker API key (free tier: 100 credits/day). PSA 10 sold prices if your plan includes graded data.
# https://www.pokemonpricetracker.com/api
POKEMONPRICETRACKER_API_KEY=

# Optional tuning
# MARKET_REVALIDATE_SECONDS=43200     # upstream cache lifetime (default 12h)
# REFRESH_MIN_INTERVAL_SECONDS=600    # min time between live refreshes (default 10 min)
# EUR_TO_USD=1.08                     # used when TCGdex only has Cardmarket (EUR) pricing
# DISABLE_TCGDEX=1
